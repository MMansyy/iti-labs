@model HomeVM

@{
    ViewData["Title"] = "Home";
}

<section class="hero p-4 p-md-5 mb-4 shadow-sm">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="badge bg-light text-primary border mb-3">Live Store Data</span>
            <h1 class="display-6 fw-bold mb-3">Welcome to ShopSphere</h1>
            <p class="text-muted mb-4">Browse real products from your catalog and manage everything in one place.</p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary px-4">Shop Now</a>
        </div>
    </div>
</section>

<div class="row row-cols-1 row-cols-md-3 g-3 mb-4">
    <div class="col">
        <div class="card panel-card p-3 h-100">
            <div class="text-muted small">Active Products</div>
            <div class="h4 mb-0">@Model.ProductsCount</div>
        </div>
    </div>
    <div class="col">
        <div class="card panel-card p-3 h-100">
            <div class="text-muted small">Categories</div>
            <div class="h4 mb-0">@Model.CategoriesCount</div>
        </div>
    </div>
    <div class="col">
        <div class="card panel-card p-3 h-100">
            <div class="text-muted small">Orders</div>
            <div class="h4 mb-0">@Model.OrdersCount</div>
        </div>
    </div>
</div>

<section>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 fw-semibold section-title mb-0">Featured Products</h2>
        <a asp-controller="Catalog" asp-action="Index" class="text-decoration-none">View all</a>
    </div>

    @if (Model.FeaturedProducts.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
            @foreach (var product in Model.FeaturedProducts)
            {
                @await Html.PartialAsync("_ProductCard", product)
            }
        </div>
    }
    else
    {
        <div class="alert alert-light border text-muted">No products are available yet.</div>
    }
</section>
