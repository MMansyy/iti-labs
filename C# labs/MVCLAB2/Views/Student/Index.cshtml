@model IEnumerable<Student>

@{
    ViewData["Title"] = "Index";
}
<div class="d-flex justify-content-between align-items-center">
    <h1>Index</h1>
    <p>
        <a asp-action="Create" class="btn btn-outline-primary">Create New</a>
    </p>
</div>

<table class="table table-striped table-hover table-bordered">
    <thead>
        <tr>
            <th>
                Name
            </th>
            <th>
                Age
            </th>
            <th>
                Department
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.name
                </td>
                <td>
                    @item.age
                </td>
                <td>
                    @item.department?.deptName
                </td>
                <td class="d-flex justify-content-between align-items-center gap-1">
                    <a class="btn btn-outline-warning flex-grow-1" asp-action="Edit" asp-route-id="@item.id">Edit</a>
                    <a class="btn btn-outline-info flex-grow-1" asp-action="Details" asp-route-id="@item.id">Details</a>
                    <a class="btn btn-outline-danger flex-grow-1" asp-action="Delete" asp-route-id="@item.id">Delete</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4" class="text-center">No students found.</td>
            </tr>
        }
    </tbody>
</table>
