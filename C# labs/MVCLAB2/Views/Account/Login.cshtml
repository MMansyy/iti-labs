@using MVCLAB2.Models.ViewModels
@model LoginVM

@{
    ViewData["Title"] = "Login";
}

<h1>Login</h1>


<form asp-action="Login">
    <div asp-validation-summary="ModelOnly"></div>
    <div class="mb-3">
        <label for="email" class="for   m-label">Email address</label>
        <input type="email" class="form-control" id="email" asp-for="email">
        <span asp-validation-for="email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input type="password" class="form-control" id="password" asp-for="password">
        <span asp-validation-for="password" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>
