          <Goal>1000</Goal>
          <Status>Case When [Measures].[Qty] &gt;= 1000 Then 1 Else -1 End</Status>
          <TrendGraphic>Standard Arrow</TrendGraphic>
          <StatusGraphic>Smiley Face</StatusGraphic>
        </Kpi>
      </Kpis>
